# Hlavičky pre Netlify a Cloudflare Pages (vytvára tools/build.mjs)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)
  X-Frame-Options: SAMEORIGIN
# service worker sa musí vždy overiť na serveri, inak by sa nové verzie oneskorovali
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Content-Type: application/manifest+json
/downloads/krizova-prirucka-cs.epub
  Content-Type: application/epub+zip
/downloads/krizova-prirucka-en.epub
  Content-Type: application/epub+zip
/downloads/krizova-prirucka-hu.epub
  Content-Type: application/epub+zip
/downloads/krizova-prirucka-pl.epub
  Content-Type: application/epub+zip
/downloads/krizova-prirucka-sk.epub
  Content-Type: application/epub+zip
/downloads/offline/*
  Content-Type: application/octet-stream
