  "description": "Krízová príručka – aplikácia s knihou, plánovačom a mapou (SK, CS, EN, PL, HU)",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:web": "node tools/build.mjs --no-pdf --no-epub",
