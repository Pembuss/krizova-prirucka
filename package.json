    "package": "node tools/package.mjs",
    "package:web": "node tools/package.mjs --web",
    "test": "node tools/test.mjs",
    "test:quick": "node tools/test.mjs --quick",
    "serve": "npx http-server dist -p 8080 -c-1",
    "i18n": "node tools/i18n.mjs"
  },
